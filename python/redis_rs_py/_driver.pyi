# Type stubs for the _driver Rust extension module.
#
# Hand-maintained until pyo3-stub-gen becomes viable. Stubs for `Redis`
# and `redis_rs_py.asyncio.Redis` are minimal pending a sweep that
# captures the full per-command surface; for now type-checkers fall
# back to `Any` for the command methods via the `__getattr__` escape
# hatch.

import builtins
from typing import Any

# Alias so that stubs inside the class body (where `set` refers to the method)
# can still reference the builtin set type.
_Set = builtins.set

__version__: str

